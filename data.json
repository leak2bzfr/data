{
  "brain": {
    "name": "NAYKROZ CORE",
    "version": "9.0",
    "mode": "ULTRA_AI_PREDICTOR",
    "selfLearning": true,
    "adaptiveSystem": true,
    "realTimeAnalysis": true,
    "dynamicRisk": true,
    "multiLayerPrediction": true,
    "deepPatternRecognition": true,
    "quantumMode": false
  },

  "grid": {
    "size": 5,
    "cells": 25,
    "defaultMines": 3,
    "dynamicDetection": true
  },

  "predictionEngine": {

    "finalScoreFormula": "

    (
      probability * 0.30 +
      confidence * 0.15 +
      reinforcement * 0.15 +
      heatmap * 0.10 +
      entropy * 0.05 +
      bayesian * 0.10 +
      markov * 0.05 +
      streakScore * 0.05 +
      antiTrap * 0.05
    )

    ",

    "minimumConfidence": 0.62,

    "safeThreshold": 0.70,

    "dangerThreshold": 0.40,

    "predictionCount": 5,

    "adaptivePredictionCount": true,

    "explorationRate": 0.12,

    "exploitationRate": 0.88,

    "preferUntouchedCells": true,

    "avoidRepeatedDeaths": true,

    "smartRiskControl": true
  },

  "algorithms": {

    "probability": {

      "enabled": true,

      "weight": 0.30,

      "formula": "safe / (safe + mine)",

      "minimumGames": 15
    },

    "bayesian": {

      "enabled": true,

      "weight": 0.10,

      "priorConfidence": 0.50,

      "adaptivePrior": true
    },

    "reinforcementLearning": {

      "enabled": true,

      "weight": 0.15,

      "learningRate": 0.12,

      "discountFactor": 0.90,

      "reward": {

        "safeClick": 12,

        "multiSafe": 20,

        "fullWin": 60,

        "rarePattern": 35
      },

      "punishment": {

        "mineClick": -20,

        "instantLoss": -45,

        "trapSequence": -30
      }
    },

    "heatmap": {

      "enabled": true,

      "weight": 0.10,

      "preferEdges": false,

      "preferCenter": false,

      "dynamicBias": true,

      "adaptiveZones": true
    },

    "entropy": {

      "enabled": true,

      "weight": 0.05,

      "detectWeakRNG": true,

      "trackChaos": true,

      "entropyThreshold": 0.65
    },

    "patternRecognition": {

      "enabled": true,

      "weight": 0.12,

      "track": [

        "mineRepeats",
        "safeChains",
        "safeClusters",
        "diagonalPatterns",
        "crossPatterns",
        "edgeCycles",
        "centerCycles",
        "nonceBias",
        "timeBias",
        "postWinBias",
        "postLossBias"
      ],

      "memoryDepth": 5000
    },

    "markovChains": {

      "enabled": true,

      "weight": 0.08,

      "stateMemory": 2000,

      "transitionLearning": true
    },

    "monteCarlo": {

      "enabled": true,

      "weight": 0.12,

      "simulations": 10000,

      "adaptiveSimulationDepth": true
    },

    "antiTrapSystem": {

      "enabled": true,

      "weight": 0.05,

      "detectFakeSafeZones": true,

      "avoidConsecutiveDeaths": true
    }
  },

  "adaptiveRules": [

    {
      "if": "recentLosses >= 3",
      "action": "reduceRisk",
      "riskMultiplier": 0.65
    },

    {
      "if": "safeStreak >= 5",
      "action": "increaseConfidence",
      "bonus": 0.10
    },

    {
      "if": "entropyLow",
      "action": "activatePatternMode"
    },

    {
      "if": "sameCellMineRepeated >= 3",
      "action": "temporaryBlacklist"
    },

    {
      "if": "highConfidenceCellsDetected",
      "action": "aggressivePrediction"
    },

    {
      "if": "rngPatternDetected",
      "action": "increasePatternWeight"
    }
  ],

  "riskManager": {

    "enabled": true,

    "mode": "adaptive",

    "maxRisk": 0.68,

    "safeModeThreshold": 0.50,

    "aggressiveModeThreshold": 0.82,

    "autoCashout": {

      "enabled": true,

      "targetMultiplier": 1.80,

      "dynamicCashout": true
    },

    "stopLoss": {

      "enabled": true,

      "maxLosses": 5
    }
  },

  "rngAnalysis": {

    "enabled": true,

    "trackNonce": true,

    "trackTimestamp": true,

    "trackServerSeed": true,

    "trackClientSeed": true,

    "trackBetAmount": true,

    "trackPreviousGames": true,

    "detectSeedCycles": true,

    "detectBias": true,

    "detectTimingPatterns": true,

    "patternSensitivity": 0.75
  },

  "memory": {

    "enabled": true,

    "maxGames": 1000000,

    "saveLocally": true,

    "mergeRemoteData": true,

    "savePatterns": true,

    "saveTransitions": true,

    "saveHeatmaps": true,

    "saveEntropyData": true
  },

  "overlay": {

    "enabled": true,

    "theme": "orange_black",

    "opacity": 0.35,

    "glow": true,

    "animated": true,

    "showConfidence": true,

    "showProbability": true,

    "showHeatmap": true,

    "safeColor": "#ff9900",

    "dangerColor": "#ff3300",

    "ultraSafeColor": "#00ff99"
  },

  "ui": {

    "theme": "NAYKROZ",

    "primaryColor": "#ff9900",

    "background": "#0f0f0f",

    "glassmorphism": true,

    "animations": true,

    "liveStats": true,

    "showAIStatus": true,

    "showPredictionStrength": true
  },

  "cells": {

    "0": {

      "safe": 2301,

      "mine": 822,

      "confidence": 0.74,

      "streak": 4,

      "entropy": 0.61,

      "heat": 0.68,

      "markov": 0.72,

      "bayesian": 0.71,

      "antiTrap": 0.84,

      "patterns": {

        "edgeSafeBias": true,

        "postWinSafe": true
      },

      "history": [

        "safe",
        "safe",
        "mine",
        "safe",
        "safe"
      ]
    }

  },

  "liveLearning": {

    "enabled": true,

    "updateAfterEachGame": true,

    "selfCorrecting": true,

    "dynamicWeightAdjustment": true,

    "automaticPatternDetection": true,

    "autoBlacklistDangerCells": true,

    "autoBoostSafeCells": true
  },

  "neuralSimulation": {

    "enabled": true,

    "virtualThinking": true,

    "virtualGames": 5000,

    "predictionLayers": 4,

    "adaptiveScoring": true
  }
}
